# Copy this file to `keystore.properties` (same directory) and fill in your values.
# `keystore.properties` is gitignored so your signing material never lands in the repo.
#
# storeFile may be absolute or relative to the repo root, e.g.:
#   storeFile=../hbconnect-release.jks
#   storeFile=C:/Users/you/keys/hbconnect-release.jks
#
# When keystore.properties is absent, release builds fall back to the debug key.

storeFile=path/to/your-release.jks
storePassword=your-keystore-password
keyAlias=your-key-alias
keyPassword=your-key-password
